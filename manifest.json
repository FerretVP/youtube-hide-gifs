{
  "manifest_version": 3,
  "name": "YouTube Hide GIFs",
  "version": "0.1.0",
  "description": "Hides GIFs in YouTube comments.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "YouTube Hide GIFs"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
